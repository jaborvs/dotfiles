#
# @desc Sway minimal configuration for productivity
# @auth jaborvs
#

### Includes ##################################################################

# Default configuration
include /etc/sway/config.d/*

# Custom configuration
include ~/.config/sway/settings
include ~/.config/sway/keybinds

### Output ####################################################################

# Wallpaper
output * bg ~/Pictures/wallpapers/frame_106.png fill

# Monitor layout: AOC (HDMI-A-1) centered above Asus (DP-1)
# Asus XG27ACS: 2560x1440 at bottom
output DP-1 resolution 2560x1440 position 0,1080
# AOC 24G2W1G4: 1920x1080 centered above Asus → x=(2560-1920)/2=320, y=0
output HDMI-A-1 resolution 1920x1080 position 320,0

### Input #####################################################################

input "1133:45108:Logitech_MX_Master_3S" {
    accel_profile "flat"
    pointer_accel 0
}

input type:keyboard {
    xkb_layout "us,us"
    xkb_variant "intl,"
    xkb_options "lv3:switch"
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

#### Idle #####################################################################

exec_always "killall -q swayidle; swayidle -w \
    timeout 180 'swaylock' \
    before-sleep 'swaylock'"

### Status bar ################################################################

bar {
    position top

    swaybar_command waybar
    
    icon_theme $icon_theme

    colors {
        statusline $fg
        background $bg
        #                   border  bg      text
        focused_workspace   $accent $accent $bg
        inactive_workspace  $bg     $bg     $fg
        urgent_workspace    $bg     $bg     $fg
    }
}


### Containers ################################################################

gaps inner 10
gaps outer 0
default_border pixel 1
default_floating_border pixel 1
titlebar_padding 10 3
titlebar_border_thickness 1

client.background       $bg

# class                 border       backgr.  text    indicator child_border
client.focused          $accent      $bg_alt  $fg     $accent   $accent
client.focused_inactive $border_gray $bg_alt  $fg     $border_gray $border_gray
client.unfocused        $border_gray $bg_alt  $fg     $border_gray $border_gray
client.urgent           $bg_alt      $bg_alt  $fg     $bg_alt   $bg_alt
client.placeholder      $bg_alt      $bg_alt  $fg     $bg_alt   $bg_alt

### Autostart #################################################################

# xdg (screenshare)
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec_always "killall -q xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal; sleep 1; /usr/libexec/xdg-desktop-portal-wlr & sleep 1; /usr/libexec/xdg-desktop-portal-gtk & sleep 1; /usr/libexec/xdg-desktop-portal --replace"

# mako (notification)
exec_always pkill mako; mako

# yubikey-touch-detector (touch prompts): it starts with the systemd user session, before logind
# grants this user the key's /dev/hidraw ACL, and never retries a key it couldn't open. Restart it
# once the graphical session is up.
exec systemctl --user restart yubikey-touch-detector.service

# kanshi (displays)
exec_always pkill kanshi; kanshi
