{
    "layer": "bottom",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "modules-left": ["custom/clock", "custom/pomodoro", "sway/workspaces", "sway/mode"],
    "modules-center": [],
    "modules-right": [
        "cpu", 
        "memory", 
        "disk", 
        "temperature", 
        "custom/volume", 
        "backlight", 
        "network", 
        "battery", 
        "sway/language",
        "custom/power",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "<span color='#252525'>[ </span>{icon}{name}<span color='#252525'> ]</span>",
        "format-icons": {
            "default": "",
            "urgent": "!",
            "focused": "*"
        }
    },

    "sway/mode": {
        "format": "  {}"
    },

    "cpu": {
        "format": "<span color='#252525'>[ </span><span color='#afa193'><b>cpu:</b></span> {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>mem:</b></span> {percentage}%",
        "interval": 5
    },

    "disk": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>dsk:</b></span> {percentage_used}%",
        "interval": 20,
        "path": "/"
    },

    "temperature": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>tmp:</b></span> {temperatureC}°C",
        "interval": 5
    },

    "custom/volume": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>vol:</b></span> {}",
        "exec": "~/.config/waybar/scripts/volume-watch.py",
        "restart-interval": 2,
        "on-scroll-up": "~/.config/sway/scripts/volume.sh up",
        "on-scroll-down": "~/.config/sway/scripts/volume.sh down",
        "tooltip": false
    },
    
    "backlight": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>bri:</b></span> {percent}%",
        "tooltip": false
    },

    "network": {
        "format-wifi": "<span color='#252525'> / </span><span color='#afa193'><b>wif:</b></span> {bandwidthDownBytes}",
        "format-ethernet": "<span color='#252525'> / </span><span color='#afa193'><b>eth:</b></span> up",
        "format-disconnected": "<span color='#252525'> / </span><span color='#afa193'><b>net:</b></span> down",
        "tooltip": false
    },

    "battery": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}%",
        "format-charging": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}% <span color='#afa193'></span>",
        "format-plugged": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}% <span color='#afa193'></span>",
        "format-not-charging": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}% <span color='#afa193'></span>",
        "format-full": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}% <span color='#afa193'></span>",
        "tooltip": false,
        "interval": 20
    },

    "sway/language": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>key:</b></span> {short}{variant}<span color='#252525'> ] </span>",
        "tooltip": false
    },

    "custom/power": {
        "format": "<span color='#afa193'><b>⏻</b></span>",
        "tooltip": false,
        "on-click": "swaynag -t warning -m 'Shutdown the system?' -B 'Yes, shutdown' 'systemctl poweroff' -B 'Cancel' ''"
    },

    "custom/pomodoro": {
        "format": "<span color='#252525'> / </span>{}<span color='#252525'> ] / </span>",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-module-pomodoro --no-icons --no-work-icons --persist",
        "on-click": "~/.local/bin/waybar-module-pomodoro toggle",
        "on-click-right": "~/.local/bin/waybar-module-pomodoro reset"
    },

    "custom/clock": {
        "format": "<span color='#252525'>[ </span>{}",
        "exec": "date +'%H:%M|%A, %b %d' | awk -F'|' '{print $1 \" <span color=\\\"#afa193\\\">\" tolower($2) \"</span>\"}'",
        "interval": 3
    },
    
    "tray": {
        "icon-size": 20,
        "spacing": 7,
        "tooltip": false
    }
}
