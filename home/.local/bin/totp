#!/usr/bin/env python3
"""totp — TOTP codes on the desktop, secrets encrypted with a FIDO2 key (age + age-plugin-fido2-hmac).

Each account is one file ~/.local/share/totp/<name>.age holding its otpauth:// URI, encrypted to the
recipient created by `totp init`. Adding accounts needs no key; reading a code needs a touch on the key.

  totp init                       create the key-bound recipient (key plugged in, run in a terminal)
  totp add NAME [URI|SECRET]      add an account (reads from stdin/prompt if omitted)
  totp import-google [--dev /dev/videoN] [IMAGE...]
                                  import Google Authenticator export QRs (webcam if no IMAGE)
  totp list                       list accounts
  totp code NAME                  print the current code
  totp pick [--type]              rofi picker: copy the code (or type it with wtype)
  totp rm NAME                    delete an account
"""
import base64, fcntl, getpass, hashlib, hmac, os, re, shutil, signal, struct, subprocess, sys, threading, time, urllib.parse
from pathlib import Path

CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "totp"
STORE = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "totp"
RECIPIENT = CONF / "recipient"
IDENTITY = CONF / "identity"  # only exists if `init` chose a separate identity
CLIP_CLEAR_SECS = 45
ICONS = STORE / "icons"  # optional per-account override: icons/<name>.svg|png
PROMPT = "\U000f0bc4 totp:"  # nf-md-shield_key, same style as rofi's "app:" prompt
ICON_ALIASES = {"ubuntu-one": "ubuntu-logo-icon"}  # account name -> Papirus icon name
ICON_FALLBACK = "password"


def icon_for(name):
    """Icon for a menu entry: user override file, else a matching Papirus app icon, else a generic key."""
    base = name.split(":")[0]
    for ext in ("svg", "png"):
        if (ICONS / f"{base}.{ext}").exists():
            return str(ICONS / f"{base}.{ext}")
    for cand in (ICON_ALIASES.get(base), base, base.split("-")[0]):
        if cand and any(Path(f"/usr/share/icons/Papirus/{s}/apps/{cand}.svg").exists() for s in ("64x64", "48x48")):
            return cand
    return ICON_FALLBACK


def die(msg):
    notify(msg) if not sys.stdin.isatty() else None
    sys.exit(f"totp: {msg}")


def notify(msg, urgency="normal"):
    """One totp notification on screen at a time: each one replaces the previous."""
    if not shutil.which("notify-send"):
        return
    id_file = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "totp.notify-id"
    prev = id_file.read_text().strip() if id_file.exists() else ""
    replace = ["-r", prev] if prev.isdigit() else []
    r = subprocess.run(["notify-send", "-p", *replace, "-a", "totp", "-u", urgency, "TOTP", msg],
                       capture_output=True, text=True, check=False)
    if r.stdout.strip().isdigit():
        id_file.write_text(r.stdout.strip())


# --- TOTP (RFC 6238) ---------------------------------------------------------

def parse_uri(text):
    """Accept an otpauth://totp URI or a bare base32 secret; return normalized URI and params."""
    text = text.strip()
    if text.startswith("otpauth://"):
        u = urllib.parse.urlparse(text)
        if u.netloc != "totp":
            raise ValueError(f"only TOTP is supported, not {u.netloc}")
        q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
    else:
        q = {"secret": text}
        text = f"otpauth://totp/?secret={text}"
    p = {
        "secret": re.sub(r"[\s-]", "", q.get("secret", "")).upper(),
        "digits": int(q.get("digits", 6)),
        "period": int(q.get("period", 30)),
        "algorithm": q.get("algorithm", "SHA1").upper(),
    }
    if p["algorithm"] not in ("SHA1", "SHA256", "SHA512"):
        raise ValueError(f"unsupported algorithm: {p['algorithm']}")
    try:
        totp(p)  # validates the secret
    except (base64.binascii.Error, ValueError) as e:
        raise ValueError(f"invalid base32 secret ({e})") from None
    return text, p


def totp(p, now=None):
    key = base64.b32decode(p["secret"] + "=" * (-len(p["secret"]) % 8), casefold=True)
    if not key:
        raise ValueError("empty secret")
    counter = int((time.time() if now is None else now) // p["period"])
    mac = hmac.new(key, struct.pack(">Q", counter), getattr(hashlib, p["algorithm"].lower())).digest()
    off = mac[-1] & 0x0F
    code = (struct.unpack(">I", mac[off:off + 4])[0] & 0x7FFFFFFF) % 10 ** p["digits"]
    return str(code).zfill(p["digits"])


def remaining(p):
    return p["period"] - int(time.time()) % p["period"]


# --- storage -----------------------------------------------------------------

def safe_name(name):
    """Slug used as file name and menu entry: lowercase, spaces -> '-' (e.g. "Ubuntu One" -> "ubuntu-one")."""
    name = re.sub(r"\s+", "-", name.strip().lower())
    name = re.sub(r"-*:-*", ":", re.sub(r"-{2,}", "-", re.sub(r"[^\w.@:+-]", "-", name))).strip(".-:")
    if not name:
        raise ValueError("empty name")
    return name


def path_for(name):
    return STORE / f"{safe_name(name)}.age"


def names():
    return sorted(p.name[:-4] for p in STORE.glob("*.age"))


def encrypt(name, uri, force=False):
    if not RECIPIENT.exists():
        die("run `totp init` first")
    dest = path_for(name)
    if dest.exists() and not force:
        raise FileExistsError(dest.name[:-4])
    STORE.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = dest.with_suffix(".tmp")
    subprocess.run(["age", "-R", str(RECIPIENT), "-o", str(tmp)], input=uri.encode(), check=True)
    tmp.replace(dest)


_lock_fd = None
_child = None  # running rofi/age, in its own process group so the whole tree (age + plugin) can be killed


def mako_mode(flag):
    """Toggle mako's `totp` mode (-a/-r). Hides yubikey-touch-detector's prompt while totp shows its own;
    a no-op without mako."""
    if not shutil.which("makoctl"):
        return
    if flag == "-r":  # the detector closes its prompt a moment after the touch: leave the mode after that
        deadline = time.monotonic() + 1
        while time.monotonic() < deadline and "yubikey-touch-detector" in subprocess.run(
                ["makoctl", "list"], capture_output=True, text=True).stdout:
            time.sleep(0.05)
    subprocess.run(["makoctl", "mode", flag, "totp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _on_cancel(signum, frame):
    """A newer request took over: drop our pending key request silently."""
    if _child and _child.poll() is None:
        os.killpg(_child.pid, signal.SIGTERM)
    mako_mode("-r")  # os._exit skips the finally in decrypt
    os._exit(0)


def run_child(cmd, stdin=None):
    global _child
    _child = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              text=True, start_new_session=True)
    try:
        out, err = _child.communicate(stdin)
        return _child.returncode, out, err
    finally:
        if _child.poll() is None:  # Ctrl+C: the group is detached from the terminal, kill it ourselves
            os.killpg(_child.pid, signal.SIGTERM)
        _child = None


def key_lock():
    """One pending key request at a time; a new one cancels the previous. Two concurrent requests race
    for a single touch, so the code you get could belong to the other account."""
    global _lock_fd
    if _lock_fd is not None:
        return
    fd = os.open(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "totp.lock", os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + 5
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.monotonic() > deadline:
                die("could not cancel the previous YubiKey request")
            try:
                os.kill(int(os.pread(fd, 32, 0).decode() or 0), signal.SIGTERM)
            except (ValueError, ProcessLookupError):
                pass
            time.sleep(0.1)
    signal.signal(signal.SIGTERM, _on_cancel)
    os.ftruncate(fd, 0)
    os.pwrite(fd, str(os.getpid()).encode(), 0)
    _lock_fd = fd  # held until the process exits


def decrypt(name):
    src = path_for(name)
    if not src.exists():
        die(f"no such account: {name}")
    key_lock()
    ident = ["-i", str(IDENTITY)] if IDENTITY.exists() else ["-j", "fido2-hmac"]
    rc, out, err = run_child(["age", "-d", *ident, str(src)])
    if rc != 0:
        if "operation denied" in err or "pin required" in err:
            die("the YubiKey rejected the fingerprint. If it keeps failing, it is locked after too many attempts:"
                " unlock it with the PIN (chrome://settings/securityKeys → Fingerprints)")
        die("could not decrypt (key plugged in and touched in time?)\n" + err.strip())
    return parse_uri(out)[1]


# --- Google Authenticator export (otpauth-migration://offline?data=...) ------

def _varint(b, i):
    shift = val = 0
    while True:
        c = b[i]; i += 1
        val |= (c & 0x7F) << shift; shift += 7
        if not c & 0x80:
            return val, i


def _fields(b):
    """Minimal protobuf decoder: yields (field_number, value) for varint and length-delimited fields."""
    i = 0
    while i < len(b):
        key, i = _varint(b, i)
        num, wt = key >> 3, key & 7
        if wt == 0:
            v, i = _varint(b, i)
        elif wt == 2:
            n, i = _varint(b, i); v = b[i:i + n]; i += n
        elif wt == 1:
            v = b[i:i + 8]; i += 8
        elif wt == 5:
            v = b[i:i + 4]; i += 4
        else:
            raise ValueError(f"protobuf wire type {wt}")
        yield num, v


def parse_migration(uri):
    q = urllib.parse.parse_qs(urllib.parse.urlparse(uri.strip()).query)
    payload = base64.b64decode(q["data"][0])
    algos = {0: "SHA1", 1: "SHA1", 2: "SHA256", 3: "SHA512"}
    out = []
    for num, v in _fields(payload):
        if num != 1:  # otp_parameters
            continue
        f = {"secret": b"", "name": "", "issuer": "", "algorithm": 1, "digits": 1, "type": 2}
        for n, x in _fields(v):
            key = {1: "secret", 2: "name", 3: "issuer", 4: "algorithm", 5: "digits", 6: "type"}.get(n)
            if key:
                f[key] = x.decode() if key in ("name", "issuer") else x
        if f["type"] != 2:
            print(f"  skipped (not TOTP): {f['issuer']} {f['name']}", file=sys.stderr)
            continue
        if f["algorithm"] not in algos:
            print(f"  skipped (unsupported algorithm): {f['issuer']} {f['name']}", file=sys.stderr)
            continue
        secret = base64.b32encode(f["secret"]).decode().rstrip("=")
        digits = 8 if f["digits"] == 2 else 6
        issuer, name = f["issuer"].strip(), f["name"].strip()
        account = name.split(":", 1)[-1].strip() if issuer and name.startswith(issuer + ":") else name
        label = f"{issuer}:{account}" if issuer else account
        query = urllib.parse.urlencode({"secret": secret, "issuer": issuer, "algorithm": algos[f["algorithm"]], "digits": digits, "period": 30})
        out.append((issuer, account, f"otpauth://totp/{urllib.parse.quote(label)}?{query}"))
    return out


# --- commands ----------------------------------------------------------------

def cmd_init():
    if RECIPIENT.exists():
        die(f"already initialized ({RECIPIENT}); delete it by hand to start over")
    if not sys.stdin.isatty():
        die("`totp init` is interactive: run it in a terminal")
    print("Plug in the YubiKey. Recommended: PIN to decrypt = no; separate identity = no.\n")
    r = subprocess.run(["age-plugin-fido2-hmac", "-g"], stdout=subprocess.PIPE, text=True)
    if r.returncode != 0:
        die("age-plugin-fido2-hmac -g failed")
    pub = re.search(r"^# public key: (\S+)", r.stdout, re.M)
    ident = [l for l in r.stdout.splitlines() if l.startswith("AGE-PLUGIN-FIDO2-HMAC-")]
    recip = pub.group(1) if pub else next((l for l in r.stdout.splitlines() if l.startswith("age1")), None)
    if not recip:
        die("recipient not found in the output:\n" + r.stdout)
    CONF.mkdir(parents=True, exist_ok=True, mode=0o700)
    RECIPIENT.write_text(recip + "\n")
    if ident:
        IDENTITY.write_text("\n".join(ident) + "\n"); IDENTITY.chmod(0o600)
    print(f"\nDone. Recipient in {RECIPIENT}" + (f", identity in {IDENTITY}" if ident else ""))


def cmd_add(args):
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    if not args:
        die("usage: totp add NAME [URI|SECRET] [--force]")
    name = args[0]
    raw = args[1] if len(args) > 1 else (getpass.getpass("otpauth:// URI or secret: ") if sys.stdin.isatty() else sys.stdin.read())
    uri, p = parse_uri(raw)
    encrypt(name, uri, force)
    print(f"added: {safe_name(name)}")


def cameras():
    """Capture devices (/dev/videoN), skipping metadata nodes and IR sensors."""
    out = []
    for sysdir in sorted(Path("/sys/class/video4linux").glob("video*"), key=lambda p: int(p.name[5:])):
        name = (sysdir / "name").read_text().strip()
        if (sysdir / "index").read_text().strip() == "0" and "IR" not in name.split():
            out.append((f"/dev/{sysdir.name}", name))
    return out


def choose_camera(dev):
    if dev:
        return dev
    cams = cameras()
    if not cams:
        die("no webcam found")
    if len(cams) == 1 or not sys.stdin.isatty():
        return cams[0][0]
    for n, (path, name) in enumerate(cams, 1):
        print(f"  {n}) {name} ({path})", file=sys.stderr)
    pick = input(f"Which webcam? [1-{len(cams)}]: ").strip() or "1"
    return cams[int(pick) - 1][0]


EXPOSURE_STEPS = (50, 80, 120, 180, 260, 400)  # UVC units of 100 µs; phone screens overexpose under auto


def _v4l2_get(dev, ctrls):
    r = subprocess.run(["v4l2-ctl", "-d", dev, "-C", ",".join(ctrls)], capture_output=True, text=True)
    vals = dict(l.split(":", 1) for l in r.stdout.splitlines() if ":" in l)
    return {k.strip(): v.split()[0] for k, v in vals.items()}


def _v4l2_set(dev, **ctrls):
    args = [a for k, v in ctrls.items() for a in ("-c", f"{k}={v}")]
    return subprocess.run(["v4l2-ctl", "-d", dev, *args], capture_output=True).returncode == 0


def exposure_sweep(dev, stop):
    """Cycle manual exposure so a bright phone screen is readable at some step; restore on stop."""
    ctrls = ("auto_exposure", "exposure_time_absolute")
    if not shutil.which("v4l2-ctl"):
        return
    orig = _v4l2_get(dev, ctrls)
    if set(orig) != set(ctrls):
        return
    try:
        time.sleep(1.5)  # let zbarcam start streaming first
        while not stop.is_set():
            for exp in EXPOSURE_STEPS:
                if stop.is_set() or not _v4l2_set(dev, auto_exposure=1, exposure_time_absolute=exp):
                    return
                stop.wait(1.2)
    finally:
        # Exposure time is read-only under auto mode, so restore it first, then the mode.
        _v4l2_set(dev, exposure_time_absolute=orig["exposure_time_absolute"])
        _v4l2_set(dev, auto_exposure=orig["auto_exposure"])


def scan_qr(images, dev):
    if images:
        r = subprocess.run(["zbarimg", "--raw", "-q", *images], capture_output=True, text=True)
        if not r.stdout.strip():
            print("no QR code found in the images", file=sys.stderr)
        yield from r.stdout.splitlines()
        return
    dev = choose_camera(dev)
    print(f"Using {dev}. A window opens with the camera image. The exposure cycles on its own"
          " (the image darkens and brightens): hold each QR still for about 10 s until \"read\" shows up."
          " Close the window or press Ctrl+C when done.", file=sys.stderr)
    proc = subprocess.Popen(["zbarcam", "--raw", "-q", dev], stdout=subprocess.PIPE, text=True)
    stop = threading.Event()
    sweeper = threading.Thread(target=exposure_sweep, args=(dev, stop), daemon=True)
    sweeper.start()
    try:
        for line in proc.stdout:
            yield line
    except KeyboardInterrupt:
        pass
    finally:
        proc.terminate()
        stop.set()
        sweeper.join(timeout=5)


def cmd_import_google(args):
    dev = None
    if "--dev" in args:
        i = args.index("--dev")
        dev, args = args[i + 1], args[:i] + args[i + 2:]
    images = args
    for tool in ("zbarimg",) if images else ("zbarcam",):
        if not shutil.which(tool):
            die("zbar-tools missing: sudo apt install zbar-tools")
    seen, added = set(), 0
    for line in scan_qr(images, dev):
        line = line.strip()
        if not line or line in seen:
            continue
        seen.add(line)
        if not line.startswith("otpauth-migration://"):
            print(f"  QR read, but it is not a Google Authenticator export: {line[:40]}…", file=sys.stderr)
            continue
        print(f"  QR read ({len(seen)})", file=sys.stderr)
        for issuer, account, uri in parse_migration(line):
            # Menu name is the issuer ("ubuntu-one"); issuer-account only if that issuer is already taken.
            candidates = [issuer, f"{issuer}-{account}"] if issuer else [account]
            for name in candidates:
                try:
                    encrypt(name, uri)
                    added += 1
                    print(f"  added: {safe_name(name)}", file=sys.stderr)
                    break
                except FileExistsError:
                    continue
            else:
                print(f"  already exists: {safe_name(candidates[-1])}", file=sys.stderr)
    print(f"{added} accounts imported from {len(seen)} QR codes", file=sys.stderr)


def cmd_code(args):
    if not args:
        die("usage: totp code NAME")
    p = decrypt(args[0])
    print(totp(p))


def clear_clipboard_later(code):
    # Detached child: clear the clipboard after a while, only if it still holds this code.
    script = (f"import subprocess,time; time.sleep({CLIP_CLEAR_SECS}); "
              "c=subprocess.run(['wl-paste','-n'],capture_output=True,text=True).stdout; "
              f"c=={code!r} and subprocess.run(['wl-copy','--clear'])")
    subprocess.Popen([sys.executable, "-c", script], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_pick(args):
    key_lock()
    accounts = names()
    if not accounts:
        die("no accounts; use `totp add` or `totp import-google`")
    menu = "".join(f"{n}\0icon\x1f{icon_for(n)}\n" for n in accounts)
    rc, out, _ = run_child(["rofi", "-dmenu", "-i", "-show-icons", "-p", PROMPT], stdin=menu)
    choice = out.strip()
    if rc != 0 or not choice:
        return
    notify(f"Touch the YubiKey for {choice}")
    mako_mode("-a")  # our prompt replaces the detector's
    try:
        p = decrypt(choice)
    finally:
        mako_mode("-r")
    code = totp(p)
    if remaining(p) < 5:  # about to expire: wait for the next one
        time.sleep(remaining(p)); code = totp(p)
    if "--type" in args and shutil.which("wtype"):
        subprocess.run(["wtype", code], check=False)
        notify(f"{choice}: code typed")
    else:
        subprocess.run(["wl-copy", code], check=True)
        clear_clipboard_later(code)
        notify(f"{choice}: code copied (valid {remaining(p)} s, cleared from the clipboard in {CLIP_CLEAR_SECS} s)")


def cmd_rm(args):
    if not args:
        die("usage: totp rm NAME")
    path_for(args[0]).unlink()
    print(f"deleted: {safe_name(args[0])}")


def main(argv):
    os.umask(0o077)
    # age looks up age-plugin-fido2-hmac in PATH; it lives next to this script (~/.local/bin).
    here = str(Path(__file__).resolve().parent)
    if here not in os.environ.get("PATH", "").split(":"):
        os.environ["PATH"] = f"{here}:{os.environ.get('PATH', '')}"
    cmd, args = (argv[0], argv[1:]) if argv else ("pick", [])
    try:
        if cmd == "init": cmd_init()
        elif cmd == "add": cmd_add(args)
        elif cmd == "import-google": cmd_import_google(args)
        elif cmd in ("list", "ls"): print("\n".join(names()))
        elif cmd == "code": cmd_code(args)
        elif cmd == "pick": cmd_pick(args)
        elif cmd == "rm": cmd_rm(args)
        else: print(__doc__); sys.exit(0 if cmd in ("-h", "--help", "help") else 2)
    except FileExistsError as e:
        die(f"{e} already exists; use --force to overwrite")
    except ValueError as e:
        die(str(e))


if __name__ == "__main__":
    main(sys.argv[1:])
